DB_URL=jdbc:mysql://localhost:3306/ssafyproj?serverTimezone=UTC
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
OPENAI_API_KEY=your-openai-api-key
REDIS_URI=redis://127.0.0.1:6379
REDIS_PASSWORD=your-redis-password
JWT_SECRET=replace-with-a-strong-base64-secret
SERVER_PORT=8080
NAVER_NEWS_ENABLED=false
NAVER_NEWS_BASE_URL=https://openapi.naver.com
NAVER_NEWS_CLIENT_ID=your-naver-client-id
NAVER_NEWS_CLIENT_SECRET=your-naver-client-secret
NAVER_NEWS_QUERY=부동산
NAVER_NEWS_SORT=sim
NAVER_NEWS_MAX_START=1000
NAVER_NEWS_BATCH_SIZE=100
NAVER_NEWS_COMMIT_BATCH_SIZE=500
NAVER_NEWS_CRON=0 0 * * * *
